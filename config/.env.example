# opencode-session-mirror 配置
#
# 复制到插件配置目录：
#   herdr plugin config-dir opencode.session-mirror
# 然后把本文件内容写成那个目录下的 .env，改完重启管理器面板即可生效。
#
# 真实环境变量可以覆盖同名项，适合临时试参数：
#   POLL_INTERVAL_MS=2000 herdr plugin pane open --plugin opencode.session-mirror --entrypoint board

# ── OpenCode server ───────────────────────────────────────────────

# 显式指定 opencode server 地址，留空则自动探测。
# 探测方式：先试默认端口 4096，再用 ss -ltnp / lsof 找出进程名含 opencode
# 的监听端口，逐个请求健康检查确认。
# 例：http://127.0.0.1:4096
OPENCODE_SERVER_URL=

# Basic Auth 用户名。opencode --service 模式默认就是 opencode。
OPENCODE_SERVER_USERNAME=opencode

# Basic Auth 密码。开了 OPENCODE_SERVER_PASSWORD 的 server 必须配。
# 留空且 AUTO_AUTH_SERVICE_JSON=true 时，会自动读
# ~/.config/opencode/service.json 里的 password（opencode 自己写的那个文件）。
OPENCODE_SERVER_PASSWORD=

# ── 镜像行为 ──────────────────────────────────────────────────────

# 镜像标签页的名字。每个目录会在【它自己的工作区】里独占一个同名标签页放镜像 pane，
# 这样绝不往你正在用的工作标签页里插 pane，多 pane 布局不会被挤压。
# Herdr 会自动加 "[N] " 前缀，最终显示成 "[3] oc-sessions"。
MIRROR_TAB_LABEL=oc-sessions

# 【兜底】工作区名。只有当某个 session 的目录在你的 herdr 里找不到任何对应工作区时
# （例如 session 在 /tmp 下而你没在那里开过 workspace）才会建这个工作区，
# 并在日志里写明「该目录没有对应的工作区，已归入 Sessions 兜底工作区」。
# 目录全部恢复之后它会被自动关掉。
MIRROR_LABEL=Sessions

# Herdr 恢复会话后是否自动拉起管理器。false = 需要手动打开看板
# （prefix+shift+o，或插件 action「OpenCode Session 看板」）。
AUTO_START=false

# 镜像 pane 的初始切分比例（0.02–0.98）。
# 新 pane 切出来后会立刻对该标签页做一次布局重平衡（layout.set_split_ratio），
# 让所有镜像 pane 均分空间，所以这个值几乎立刻就被覆盖了 —— 留着只是调试用。
MIRROR_PANE_RATIO=0.5

# 镜像 pane 排列方向：down | right
MIRROR_PANE_DIRECTION=down

# 常规重平衡巡检间隔（毫秒，5000–600000）。
# 建行和回收时的重平衡是即时的，不受这个值影响。这里只负责把**别人**改乱的
# 布局纠回来 —— sidebar 插件会给每个标签页注入自己的 Sidebar pane 并重排整页，
# 用户也可能手动拖动分割条。比例已经正确时不会下发任何 set_split_ratio，
# 所以稳定状态下这里只有两次读、没有写。
REBALANCE_INTERVAL_MS=30000

# session 行树状前缀里的「父级竖线」。默认空 —— 用户反馈这条竖线多余。
# Herdr 会 trim 前导空白，所以想改成空格缩进做不到（传 "  └─ x" 存下来是
# "└─ x"）。要加回来就填一个非空白字符，比如 "│"。
PARALLEL_TRUNK=

# 单个 token 值的上限（8–80）。实测 Herdr 对单个 token 值硬截断在 80 字符，
# 插件自己先算好、留点余量（78）并用「+N」收尾，避免被拦腰截断在半句话上。
PARALLEL_TOKEN_MAX=78

# 该 agent 的工作区里没有并行 session 时，官方 session 自己那一行还要不要写。
# 默认要 —— 侧边栏模板里已经去掉了 terminal_title_stripped（它的缩进和插件行
# 不一致，两种格式混在一起读不出层级），不写就等于官方标题直接消失。
INLINE_ALWAYS_LIST=true

# 焦点落到镜像 pane 时，自动转到该目录真正的前台 agent（Herdr 自己侦测到、
# 且不是我们上报的那一行）。Herdr 没有「某行不可点击」的开关，只能让跳转落到
# 有用的地方。落点优先挑用户自己标签页里的 agent；该工作区没有官方 agent 时
# 不跳转，保留只读卡片。
# 副作用：切工作区时若上次聚焦的是镜像 pane，同样会被弹走（多数时候正合心意）。
# 想完全关掉就设成 false。
FOCUS_REDIRECT=true

# 同一个镜像行的重定向冷却（毫秒，0–60000），用来防抖。
FOCUS_REDIRECT_COOLDOWN_MS=2500

# 恢复命令：恒为常驻进程（node mirror.mjs），镜像 pane 内绝不运行 opencode。
# 曾经有过 RESUME_MODE=opencode（恢复命令 opencode --session <id>），已删除 ——
# 它会在 Herdr 重启时于镜像 pane 里拉起 opencode，官方集成随即在同一个 pane 覆盖掉
# 我们这一行（不是新增重复行），该目录的镜像功能静默失效。写了这个变量会被忽略，
# 并在启动日志里给出提示。
#   RESUME_MODE=mirror        # 已无效果，留着只为消除旧配置的告警

# ── 轮询与容错 ────────────────────────────────────────────────────

# 轮询兜底间隔（毫秒）。SSE 正常时主要用于兜底与宽限期计时。
POLL_INTERVAL_MS=5000

# session 变为非活跃后保留行的宽限时间（毫秒），用来吸收状态抖动。
# 超过这个时间还没活跃就回收镜像行和镜像 pane。
IDLE_GRACE_MS=15000

# 服务端不可达时的重试退避上限（毫秒）。
DISCOVERY_BACKOFF_MAX_MS=60000

# ── 会话列表与 retry 探测 ─────────────────────────────────────────

# 每页拉多少条会话。
SESSION_LIST_LIMIT=200

# 最多翻几页去找活跃 session（只在第一页没覆盖全时才翻页）。
SESSION_PAGE_LIMIT=8

# 是否探测「模型调用失败正在重试」。
# opencode v2 的 /api/session/active 只有 running，重试信号在末尾消息里，
# 所以这个探测每个活跃 session 多一次 HTTP 请求。关掉可以省掉这部分开销，
# 代价是 retry 状态会退化成 working。
RETRY_DETECTION=true

# 每轮最多探测多少个 session 的 retry 状态（0 = 不探测）。
RETRY_CHECK_LIMIT=8

# ── Agents 视图投影（全局副作用） ──────────────────────────────────

# 是否安装 agent.view.set 投影。
# 这是【全局】设置，会影响整个 Agents 侧边栏的排序与过滤，所以默认关闭。
INSTALL_AGENT_VIEW=false

# 投影范围：
#   mirror    = 只显示本插件的镜像行（按 oc_mirror token 过滤）
#   sort-only = 不过滤，只接管排序，保留所有 agent
#
# 安全底线：即使选了 mirror，只要当前一条镜像行都没有，插件就【不会】安装带筛选的
# 投影，而是自动降级成 sort-only。否则筛选会把官方集成的行全部隐藏掉，
# 侧边栏直接变成 "no matching agents" —— 插件把用户自己的视图清空了。
AGENT_VIEW_SCOPE=mirror

# ── 其它 ──────────────────────────────────────────────────────────

# 是否允许自动读取 ~/.config/opencode/service.json 里的密码去认证。
# 设 false 则只用显式配置的 OPENCODE_SERVER_PASSWORD。
AUTO_AUTH_SERVICE_JSON=true

# 日志级别：debug | info | warn | error | silent
# 排查问题时用 debug，能看到每个 session 为什么建行/不建行。
LOG_LEVEL=info
