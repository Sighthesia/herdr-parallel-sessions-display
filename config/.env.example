# opencode-session-mirror 配置
#
# 复制到插件配置目录：
#   herdr plugin config-dir opencode.session-mirror
# 然后把本文件内容写成那个目录下的 .env，改完重启管理器面板即可生效。
#
# 真实环境变量可以覆盖同名项，适合临时试参数：
#   POLL_INTERVAL_MS=2000 herdr plugin pane open --plugin opencode.session-mirror --entrypoint board

# ── OpenCode server ───────────────────────────────────────────────

# 显式指定 opencode server 地址，留空则自动探测。
# 探测方式：先试默认端口 4096，再用 ss -ltnp / lsof 找出进程名含 opencode
# 的监听端口，逐个请求健康检查确认。
# 例：http://127.0.0.1:4096
OPENCODE_SERVER_URL=

# Basic Auth 用户名。opencode --service 模式默认就是 opencode。
OPENCODE_SERVER_USERNAME=opencode

# Basic Auth 密码。开了 OPENCODE_SERVER_PASSWORD 的 server 必须配。
# 留空且 AUTO_AUTH_SERVICE_JSON=true 时，会自动读
# ~/.config/opencode/service.json 里的 password（opencode 自己写的那个文件）。
OPENCODE_SERVER_PASSWORD=

# ── 镜像行为 ──────────────────────────────────────────────────────

# 镜像工作区/标签名。所有镜像 pane 集中在这里，不打开就不占视野。
MIRROR_LABEL=Sessions

# Herdr 恢复会话后是否自动拉起管理器。false = 需要手动打开看板
# （prefix+shift+o，或插件 action「OpenCode Session 看板」）。
AUTO_START=false

# 镜像 pane 的初始切分比例（0.02–0.98）。
# 新 pane 切出来后会立刻做一次布局重平衡（layout.set_split_ratio），
# 让所有镜像 pane 均分空间，所以这个值几乎立刻就被覆盖了 —— 留着只是调试用。
MIRROR_PANE_RATIO=0.5

# 镜像 pane 排列方向：down | right
MIRROR_PANE_DIRECTION=down

# Herdr 重启后的恢复命令。
#   opencode = opencode --session <id>（SPEC 6.2；副作用见 README）
#   mirror   = 只恢复镜像驻留进程，镜像 pane 内绝不运行 opencode
RESUME_MODE=opencode

# ── 轮询与容错 ────────────────────────────────────────────────────

# 轮询兜底间隔（毫秒）。SSE 正常时主要用于兜底与宽限期计时。
POLL_INTERVAL_MS=5000

# session 变为非活跃后保留行的宽限时间（毫秒），用来吸收状态抖动。
# 超过这个时间还没活跃就回收镜像行和镜像 pane。
IDLE_GRACE_MS=15000

# 服务端不可达时的重试退避上限（毫秒）。
DISCOVERY_BACKOFF_MAX_MS=60000

# ── 会话列表与 retry 探测 ─────────────────────────────────────────

# 每页拉多少条会话。
SESSION_LIST_LIMIT=200

# 最多翻几页去找活跃 session（只在第一页没覆盖全时才翻页）。
SESSION_PAGE_LIMIT=8

# 是否探测「模型调用失败正在重试」。
# opencode v2 的 /api/session/active 只有 running，重试信号在末尾消息里，
# 所以这个探测每个活跃 session 多一次 HTTP 请求。关掉可以省掉这部分开销，
# 代价是 retry 状态会退化成 working。
RETRY_DETECTION=true

# 每轮最多探测多少个 session 的 retry 状态（0 = 不探测）。
RETRY_CHECK_LIMIT=8

# ── Agents 视图投影（全局副作用） ──────────────────────────────────

# 是否安装 agent.view.set 投影。
# 这是【全局】设置，会影响整个 Agents 侧边栏的排序与过滤，所以默认关闭。
INSTALL_AGENT_VIEW=false

# 投影范围：
#   mirror    = 只显示本插件的镜像行（按 oc_mirror token 过滤）
#   sort-only = 不过滤，只接管排序，保留所有 agent
#
# 安全底线：即使选了 mirror，只要当前一条镜像行都没有，插件就【不会】安装带筛选的
# 投影，而是自动降级成 sort-only。否则筛选会把官方集成的行全部隐藏掉，
# 侧边栏直接变成 "no matching agents" —— 插件把用户自己的视图清空了。
AGENT_VIEW_SCOPE=mirror

# ── 其它 ──────────────────────────────────────────────────────────

# 是否允许自动读取 ~/.config/opencode/service.json 里的密码去认证。
# 设 false 则只用显式配置的 OPENCODE_SERVER_PASSWORD。
AUTO_AUTH_SERVICE_JSON=true

# 日志级别：debug | info | warn | error | silent
# 排查问题时用 debug，能看到每个 session 为什么建行/不建行。
LOG_LEVEL=info
