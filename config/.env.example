# herdr-parallel-sessions-display 配置
#
# 复制到插件配置目录：
#   herdr plugin config-dir herdr-parallel-sessions-display
# 然后把本文件内容写成那个目录下的 .env，改完重启管理器面板即可生效。
#
# 真实环境变量可以覆盖同名项，适合临时试参数：
#   POLL_INTERVAL_MS=2000 herdr plugin pane open --plugin herdr-parallel-sessions-display --entrypoint board

# ── OpenCode server ───────────────────────────────────────────────

# 显式指定 opencode server 地址，留空则自动探测。
# 探测方式：先试默认端口 4096，再用 ss -ltnp / lsof 找出进程名含 opencode
# 的监听端口，逐个请求健康检查确认。
# 例：http://127.0.0.1:4096
OPENCODE_SERVER_URL=

# Basic Auth 用户名。opencode --service 模式默认就是 opencode。
OPENCODE_SERVER_USERNAME=opencode

# Basic Auth 密码。开了 OPENCODE_SERVER_PASSWORD 的 server 必须配。
# 留空且 AUTO_AUTH_SERVICE_JSON=true 时，会自动读
# ~/.config/opencode/service.json 里的 password（opencode 自己写的那个文件）。
OPENCODE_SERVER_PASSWORD=

# ── 镜像行为 ──────────────────────────────────────────────────────

# 镜像标签页的名字。每个目录会在【它自己的工作区】里独占一个同名标签页放镜像 pane，
# 这样绝不往你正在用的工作标签页里插 pane，多 pane 布局不会被挤压。
# Herdr 会自动加 "[N] " 前缀，最终显示成 "[3] oc-sessions"。
MIRROR_TAB_LABEL=oc-sessions

# 【兜底】工作区名。只有当某个 session 的目录在你的 herdr 里找不到任何对应工作区时
# （例如 session 在 /tmp 下而你没在那里开过 workspace）才会建这个工作区，
# 并在日志里写明「该目录没有对应的工作区，已归入 Sessions 兜底工作区」。
# 目录全部恢复之后它会被自动关掉。
MIRROR_LABEL=Sessions

# Herdr 恢复会话后是否自动拉起常驻管理器。**默认 true，别关。**
#
# 关掉的后果是「静默失效」：插件照样在跑、token 照样写进去，但没人再更新它们。
# 某天重启 Herdr 之后侧边栏就不再变化了，而且没有任何报错 —— 用户只会看到
# 「列表不更新了」，得自己想到去按 prefix+shift+o。常见于装好之后过一阵子才发现。
#
# true = 每次 Herdr 恢复会话时由 [[startup]] 钩子自动开一个看板标签页。
# 代价只是多一个标签页。
AUTO_START=true

# 镜像 pane 的初始切分比例（0.02–0.98）。
# 新 pane 切出来后会立刻对该标签页做一次布局重平衡（layout.set_split_ratio），
# 让所有镜像 pane 均分空间，所以这个值几乎立刻就被覆盖了 —— 留着只是调试用。
MIRROR_PANE_RATIO=0.5

# 镜像 pane 排列方向：down | right
MIRROR_PANE_DIRECTION=down

# 常规重平衡巡检间隔（毫秒，5000–600000）。
# 建行和回收时的重平衡是即时的，不受这个值影响。这里只负责把**别人**改乱的
# 布局纠回来 —— sidebar 插件会给每个标签页注入自己的 Sidebar pane 并重排整页，
# 用户也可能手动拖动分割条。比例已经正确时不会下发任何 set_split_ratio，
# 所以稳定状态下这里只有两次读、没有写。
REBALANCE_INTERVAL_MS=30000

# session 行树状前缀里的「父级竖线」。默认空 —— 用户反馈这条竖线多余。
# Herdr 会 trim 前导空白，所以想改成空格缩进做不到（传 "  └─ x" 存下来是
# "└─ x"）。要加回来就填一个非空白字符，比如 "│"。
PARALLEL_TRUNK=

# 单个 token 值的上限（8–80）。实测 Herdr 对单个 token 值硬截断在 80 字符，
# 插件自己先算好、留点余量（78）并用「+N」收尾，避免被拦腰截断在半句话上。
PARALLEL_TOKEN_MAX=78

# 【内联模式】true = 完全不建镜像 pane、不建 oc-sessions 标签页，会话列表
# 直接挂到该目录的官方 agent 行上（默认，也是当前唯一支持多 agent 的模式）。
# false = 回到「每个并行 session 一个镜像行 + 镜像标签页」的旧模型 ——
# 那条路只支持 opencode，codex / Claude Code 不参与。
MIRROR_INLINE=true

# 该 agent 的工作区里没有并行 session 时，官方 session 自己那一行还要不要写。
# 默认要 —— 侧边栏模板里已经去掉了 terminal_title_stripped（它的缩进和插件行
# 不一致，两种格式混在一起读不出层级），不写就等于官方标题直接消失。
INLINE_ALWAYS_LIST=true

# 焦点落到镜像 pane 时，自动转到该目录真正的前台 agent（Herdr 自己侦测到、
# 且不是我们上报的那一行）。Herdr 没有「某行不可点击」的开关，只能让跳转落到
# 有用的地方。落点优先挑用户自己标签页里的 agent；该工作区没有官方 agent 时
# 不跳转，保留只读卡片。
# 副作用：切工作区时若上次聚焦的是镜像 pane，同样会被弹走（多数时候正合心意）。
# 想完全关掉就设成 false。
FOCUS_REDIRECT=true

# 同一个镜像行的重定向冷却（毫秒，0–60000），用来防抖。
FOCUS_REDIRECT_COOLDOWN_MS=2500

# 恢复命令：恒为常驻进程（node mirror.mjs），镜像 pane 内绝不运行 opencode。
# 曾经有过 RESUME_MODE=opencode（恢复命令 opencode --session <id>），已删除 ——
# 它会在 Herdr 重启时于镜像 pane 里拉起 opencode，官方集成随即在同一个 pane 覆盖掉
# 我们这一行（不是新增重复行），该目录的镜像功能静默失效。写了这个变量会被忽略，
# 并在启动日志里给出提示。
#   RESUME_MODE=mirror        # 已无效果，留着只为消除旧配置的告警

# ── 轮询与容错 ────────────────────────────────────────────────────

# 轮询兜底间隔（毫秒）。SSE 正常时主要用于兜底与宽限期计时。
POLL_INTERVAL_MS=5000

# 状态变化的防抖时间（毫秒）。两处用它，含义都是「要连续稳定这么久才动作」：
#   · 非内联模式：session 变为非活跃超过这么久就回收镜像行和镜像 pane。
#   · 内联模式（默认）：一个 session 被官方集成连续认作「当前前台 session」超过
#     这么久，就认为你已经查看过它的结果，不再列在侧边栏上。
# 内联模式下 session **停下来不会消失** —— 它会留在列表里显示 ○，让你知道哪个
# 跑完了；只有你把它切到前台、结果看过了才清除。所以这一项不是「完成后等多久
# 消失」，而是「查看过之后等多久才确认你真的看过了」。
IDLE_GRACE_MS=15000

# 每个目录最多留几条「已完成、还没查看过」的 session（仅内联模式）。
# 留着是为了让你知道哪个跑完了；0 = 回到旧行为（完成后直接消失）。
IDLE_KEEP=3

# 服务端不可达时的重试退避上限（毫秒）。
DISCOVERY_BACKOFF_MAX_MS=60000

# ── 会话列表与 retry 探测 ─────────────────────────────────────────

# 每页拉多少条会话。
SESSION_LIST_LIMIT=200

# 最多翻几页去找活跃 session（只在第一页没覆盖全时才翻页）。
SESSION_PAGE_LIMIT=8

# 是否探测「模型调用失败正在重试」。
# opencode v2 的 /api/session/active 只有 running，重试信号在末尾消息里，
# 所以这个探测每个活跃 session 多一次 HTTP 请求。关掉可以省掉这部分开销，
# 代价是 retry 状态会退化成 working。
RETRY_DETECTION=true

# 每轮最多探测多少个 session 的 retry 状态（0 = 不探测）。
RETRY_CHECK_LIMIT=8

# ── Agents 视图投影（全局副作用） ──────────────────────────────────

# 是否安装 agent.view.set 投影。
# 这是【全局】设置，会影响整个 Agents 侧边栏的排序与过滤，所以默认关闭。
INSTALL_AGENT_VIEW=false

# 投影范围：
#   mirror    = 只显示本插件的镜像行（按 oc_mirror token 过滤）
#   sort-only = 不过滤，只接管排序，保留所有 agent
#
# 安全底线：即使选了 mirror，只要当前一条镜像行都没有，插件就【不会】安装带筛选的
# 投影，而是自动降级成 sort-only。否则筛选会把官方集成的行全部隐藏掉，
# 侧边栏直接变成 "no matching agents" —— 插件把用户自己的视图清空了。
AGENT_VIEW_SCOPE=mirror

# ── codex ───────────────────────────────────────────────────────

# 是否采集 codex 的 session（走 codex 自己的 app-server，WebSocket over unix socket）。
# 关掉 = 完全不连那个守护进程，并撤掉 codex 行上已挂的列表。
CODEX_ENABLED=true

# app-server 控制 socket 路径。留空用默认
# ~/.codex/app-server-control/app-server-control.sock。守护进程起在别处时
# （`codex app-server daemon version` 会报出真实路径）指过来最省事。
CODEX_SOCKET=

# initialize 握手里上报的客户端名，出问题时 codex 那边能一眼看出这条连接是谁。
CODEX_CLIENT_NAME=herdr-parallel-sessions-display

# 认哪些来源的 thread。留空 = 内置 cli,exec,appServer,vscode（用排除法滤掉
# subAgent*，即「子 agent 不单列」）。
# **不要只填 cli**：实测本机 kind 是 vscode 的 thread 会被整批过滤掉且不报错。
CODEX_SOURCE_KINDS=

# 每页拉多少条 thread。
CODEX_SESSION_LIMIT=100

# 单次 app-server 请求超时（毫秒）。
CODEX_TIMEOUT_MS=8000

# 官方行没有 agent_session 时，由插件以 herdr:codex 的身份补报一次
#（读的是 codex 自己的 app-server，写的是真实 thread id）。
# Codex 0.160 的 SessionStart hook 在 TUI 启动时不触发，所以不补的话
# codex 在还没跑过一轮对话时完全不可见。关掉回到纯被动。
CODEX_ADOPT_SESSION=true

# ── Claude Code ──────────────────────────────────────────────────

# 是否采集 Claude Code 的 session。关掉会把 claude 行上已挂的列表撤掉
# （不会去撤销补报过的 agent_session —— 那本来就是真值）。
CLAUDE_ENABLED=true

# claude 可执行文件的路径，留空用 PATH 上的 claude。
# **注意 PATH 的差别**：Herdr 是 GUI 起的进程，它的 PATH 未必和你终端一样。
# 本机实测 Claude Code 装在 /opt/claude-code/bin/claude —— 终端里 `claude` 能跑、
# 看板面板里 spawn 不到就是这个形态。遇到就填绝对路径。
# CLAUDE_BIN=/opt/claude-code/bin/claude

# 单次 `claude agents --json` 的超时（毫秒）。实测正常调用约 260ms。
CLAUDE_TIMEOUT_MS=8000

# claude 侧的采集节奏（毫秒），**与主循环的 POLL_INTERVAL_MS 独立**。
# 默认比主循环慢一倍是有原因的：每次采集都要 spawn 一次 claude（实测约 260ms），
# 按 5 秒一次就是每 20 秒白花 260ms 常驻开销（约 5% 单核）。
# 想追平主循环设 5000，代价自己认。
#
# 另外：Herdr 里一个 agent === "claude" 的行都没有时插件会**跳过 spawn**，
# 所以你没在 Herdr 里跑 claude 时这一项零成本。
CLAUDE_POLL_MS=10000

# 最多认多少个会话（按 startedAt 新的优先）。防御性上限，正常机器上只有个位数。
CLAUDE_SESSION_LIMIT=50

# 官方行没有 agent_session 时，由插件以 herdr:claude 的身份补报一次
#（写的是 `claude agents --json` 里的真实 session id）。
# Herdr 的 claude 集成靠 hook 上报，没装时那些行**一个 agent_session 字段都没有**，
# 内联模式就无处可挂 —— 不补的话 claude 的会话一条都不显示。
# 关掉回到纯被动：只显示官方集成已经报上来的，绝不代替它写。
CLAUDE_ADOPT_SESSION=true

# 标题是默认显示名（`herdr-fe` 这种，或者后台任务拿自己的短 id 当名字）时，
# 要不要读该会话 transcript 的首条用户消息来兜底。
# 只读文件头部 64KB，且按 sessionId 记忆化（上限 200 条），代价很小。
# 关掉的唯一理由是 Claude Code 装在网络盘上、每次 stat 都很贵。
CLAUDE_READ_TITLES=true

# ── 其它 ──────────────────────────────────────────────────────────

# 是否允许自动读取 ~/.config/opencode/service.json 里的密码去认证。
# 设 false 则只用显式配置的 OPENCODE_SERVER_PASSWORD。
AUTO_AUTH_SERVICE_JSON=true

# opencode server 的地址。留空 = 自动探测（读 service.json / 扫端口 / 找进程）。
# 显式指定长这样：
#   OPENCODE_SERVER_URL=http://127.0.0.1:4096
#   OPENCODE_SERVER_PASSWORD=<Basic Auth 密码>

# 日志级别：debug | info | warn | error | silent
# 排查问题时用 debug，能看到每个 session 为什么建行/不建行。
LOG_LEVEL=info

# 会话行的连接符
#   bar（默认）= │▸ ● 标题 / │  ● 标题  ← 竖线通到底，整列对齐
#   tree        = ├─ ▸ 标题 / └─ 标题      ← 经典树状连接符
#   none        = ▸ 标题 / ● 标题          ← 完全不加前缀
PARALLEL_CONNECTOR=bar

# ── 「正在中」标记 ──────────────────────────────────────────────
# 默认实心圆、静止。想改成 opencode 那种点阵转轮，**两项都要设**
# （只设序列仍是静帧，免得填了序列就意外花 CPU）：
#   PARALLEL_BUSY_FRAMES=⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏   # Herdr 自己的点阵转轮帧
#   PARALLEL_BUSY_ANIMATE=true
#   PARALLEL_BUSY_FRAME_MS=300               # 3s 一轮，开销约减半
# 转轮实测 12% 单核、关闭 4%，所以默认关。同一行的 state_icon 本来就在转。
PARALLEL_BUSY_FRAMES=●
PARALLEL_BUSY_ANIMATE=false
PARALLEL_BUSY_FRAME_MS=150
